# --- General ---
PROJECT_ID=999  # 3-digit numeric ID to assign ports (e.g., 999 -> 33999)
PROJECT_NAME=ib
TZ=Europe/Madrid
USER_ID=1000
GROUP_ID=1000

# --- IBKR Gateway Configuration ---
IB_USER=your_ibkr_username
IB_PASS=your_ibkr_password
MODE=paper # 'paper' or 'live'
VNC_PASS=your_vnc_password

# --- IBKR Gateway Advanced Features ---
READ_ONLY_API=yes
TWOFA_TIMEOUT_ACTION=exit
AUTO_RESTART_TIME=11:59 PM
TWS_COLD_RESTART=15:00
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
ALLOW_BLIND_TRADING=yes
# Use 'primaryoverride' in production for automatic reconnect on container restart.
# WARNING: never use 'primaryoverride' on two instances sharing the same credentials —
# they will kick each other in a loop. Keep 'exit' in local/paper environments.
EXISTING_SESSION_DETECTED_ACTION=exit

# --- Database Configuration ---
DB_NAME=ibkr_stats
DB_USER=your_db_user
DB_PASS=your_db_user_password
DB_ROOT_PASS=your_db_root_password
DB_BIND_IP=172.17.0.1

# --- API Security ---
API_KEY=your_secure_api_key

# --- IBKR Connection (Python App) ---
IB_PORT=4003
IB_CLIENT_ID=10

# --- Telegram Bot ---
TG_TOKEN=your_telegram_bot_token
TG_ALLOWED_IDS=your_telegram_user_id1,your_telegram_user_id2
CASH_DIFFERENCE_CHECK_INTERVAL=300
DELTA_ALERT_TIMES="10:05,15:35,22:05"
DELTA_ALERT_THRESHOLD=0.25
DB_INSERT_INTERVAL=1800
# Comma-separated underlying tickers to exclude from alerts (e.g. box spreads: ESTX50,SPX)
DELTA_ALERT_EXCLUDE=

# --- Flex Query & Email ---
IB_FLEX_TOKEN=your_ib_flex_token
IB_FLEX_TOKEN_EXPIRY='2026-02-18, 05:34:27 EST'
IB_FLEX_SCHEDULE_TIME=07:30
IB_FLEX_DAILY_QUERY_ID=your_ib_flex_query_id
IB_FLEX_MONTHLY_QUERY_ID=your_ib_flex_monthly_query_id

# --- Email settings (for flex queries) ---
EMAIL_SENDER=no-reply@yourdomain.com
EMAIL_RECIPIENT=your_email@example.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_smtp_user
EMAIL_SMTP_PASSWORD=your_smtp_password